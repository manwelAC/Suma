<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SumaPlaceholderSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SumaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SumaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource SumaCornerMedium}" />
        <Setter Property="Padding" Value="{StaticResource SumaContentPadding}" />
    </Style>
</ResourceDictionary>
