<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="SumaBackgroundColor">#FFF7F5F0</Color>
    <Color x:Key="SumaSurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SumaSurfaceSecondaryColor">#FFF0EEE8</Color>
    <Color x:Key="SumaTextPrimaryColor">#FF20221F</Color>
    <Color x:Key="SumaTextSecondaryColor">#FF696D66</Color>
    <Color x:Key="SumaBorderColor">#FFDCDDD7</Color>
    <Color x:Key="SumaAccentColor">#FF687B68</Color>
    <Color x:Key="SumaAccentMutedColor">#FFDDE5DA</Color>

    <SolidColorBrush x:Key="SumaBackgroundBrush" Color="{StaticResource SumaBackgroundColor}" />
    <SolidColorBrush x:Key="SumaSurfaceBrush" Color="{StaticResource SumaSurfaceColor}" />
    <SolidColorBrush x:Key="SumaSurfaceSecondaryBrush" Color="{StaticResource SumaSurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="SumaTextPrimaryBrush" Color="{StaticResource SumaTextPrimaryColor}" />
    <SolidColorBrush x:Key="SumaTextSecondaryBrush" Color="{StaticResource SumaTextSecondaryColor}" />
    <SolidColorBrush x:Key="SumaBorderBrush" Color="{StaticResource SumaBorderColor}" />
    <SolidColorBrush x:Key="SumaAccentBrush" Color="{StaticResource SumaAccentColor}" />
    <SolidColorBrush x:Key="SumaAccentMutedBrush" Color="{StaticResource SumaAccentMutedColor}" />
</ResourceDictionary>
