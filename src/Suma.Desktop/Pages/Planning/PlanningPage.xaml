<Page
    x:Class="Suma.Desktop.Pages.Planning.PlanningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Suma.Desktop.ViewModels"
    Background="{StaticResource SumaBackgroundBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
        <Grid Padding="{StaticResource SumaPagePadding}" MaxWidth="1440" HorizontalAlignment="Stretch" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="{StaticResource SumaSpace4}">
                    <TextBlock Style="{StaticResource SumaPageTitleTextStyle}" Text="Planning" />
                    <TextBlock Style="{StaticResource SumaLeadTextStyle}" Text="Plan where your money should go." />
                </StackPanel>
                <Button x:Name="NewBudgetButton" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Create new budget" Click="OnNewBudgetClick" Content="New budget" Visibility="{x:Bind ViewModel.NewBudgetVisibility, Mode=OneWay}" />
            </Grid>

            <!-- Navigation Switcher Pills -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <ToggleButton x:Name="BudgetsSectionButton" AutomationProperties.Name="Show budgets planning section" Click="OnBudgetsSectionClick" Content="Budgets" Style="{StaticResource SumaNavigationItemSelectedStyle}" />
                <ToggleButton x:Name="RecurringSectionButton" AutomationProperties.Name="Show recurring planning section" Click="OnRecurringSectionClick" Content="Recurring" Style="{StaticResource SumaNavigationItemStyle}" />
                <ToggleButton x:Name="SavingsSectionButton" AutomationProperties.Name="Show savings planning section" Click="OnSavingsSectionClick" Content="Savings" Style="{StaticResource SumaNavigationItemStyle}" />
            </StackPanel>

            <!-- Main Planning Workspaces -->
            <Grid Grid.Row="2">
                <!-- 1. Budgets Section -->
                <Grid x:Name="BudgetSection" ColumnSpacing="28" RowSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BudgetListColDef" Width="380" />
                        <ColumnDefinition x:Name="BudgetDetailColDef" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: Budget List -->
                    <StackPanel x:Name="BudgetListPanel" Grid.Column="0" Grid.Row="0" Spacing="12">
                        <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Budgets" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="ActiveBudgetsButton" AutomationProperties.Name="View active budgets" Click="OnActiveBudgetsClick" Content="Active" Style="{StaticResource SumaNavigationItemSelectedStyle}" />
                            <ToggleButton x:Name="ArchivedBudgetsButton" AutomationProperties.Name="View archived budgets" Click="OnArchivedBudgetsClick" Content="Archived" Style="{StaticResource SumaNavigationItemStyle}" />
                        </StackPanel>
                        <Grid MinHeight="150">
                            <ListView x:Name="BudgetList" AutomationProperties.Name="Budget list" IsItemClickEnabled="True" ItemClick="OnBudgetItemClick" ItemsSource="{x:Bind ViewModel.Budgets, Mode=OneWay}" SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:BudgetRowViewModel">
                                        <Border Background="{StaticResource SumaSurfaceSecondaryBrush}" CornerRadius="{StaticResource SumaCornerLarge}" Padding="20">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind Name}" />
                                                    <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind PeriodDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind CurrencyCode}" />
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind ExpectedIncomeDisplay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                                <TextBlock MaxWidth="380" HorizontalAlignment="Center" Text="Create a budget to plan how much you want to set aside for each spending category." TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SumaBodySecondaryTextStyle}" Visibility="{x:Bind ViewModel.NewBudgetVisibility, Mode=OneWay}" />
                                <Button HorizontalAlignment="Center" AutomationProperties.Name="Create first budget" Click="OnNewBudgetClick" Content="New budget" Visibility="{x:Bind ViewModel.NewBudgetVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: Selected Budget Details & Allocations -->
                    <StackPanel x:Name="BudgetDetailPanel" Grid.Column="1" Grid.Row="0" Spacing="16">
                        <Border Background="{StaticResource SumaSurfaceSecondaryBrush}" CornerRadius="{StaticResource SumaCornerLarge}" Padding="24" Visibility="{x:Bind ViewModel.SelectedBudgetVisibility, Mode=OneWay}">
                            <Grid>
                                <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.DetailsContentVisibility, Mode=OneWay}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.SelectedBudget.Name, Mode=OneWay, FallbackValue='Budget details'}" />
                                            <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind ViewModel.SelectedBudget.PeriodDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button AutomationProperties.Name="Archive selected budget" Click="OnArchiveBudgetClick" Content="Archive budget" Visibility="{x:Bind ViewModel.ArchiveActionVisibility, Mode=OneWay}" />
                                            <Button AutomationProperties.Name="Restore selected budget" Click="OnRestoreBudgetClick" Content="Restore budget" Visibility="{x:Bind ViewModel.RestoreActionVisibility, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnSpacing="16" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="Expected income" />
                                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.ExpectedIncomeDisplay, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="Allocated" />
                                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.AllocatedDisplay, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="Spent" />
                                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.SpentDisplay, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="Remaining" />
                                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.RemainingDisplay, Mode=OneWay}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Allocations" />
                                            <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Actual spending comes from Expense transactions and their refunds." />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Add budget allocation" Click="OnAddAllocationClick" Content="Add allocation" Visibility="{x:Bind ViewModel.AddAllocationVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <ListView AutomationProperties.Name="Budget allocations" ItemsSource="{x:Bind ViewModel.Allocations, Mode=OneWay}" SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0,0,0,8" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:BudgetAllocationRowViewModel">
                                                <Border BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,6">
                                                    <Grid ColumnSpacing="16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind CategoryDisplay}" />
                                                            <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind ReserveDisplay}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind AllocatedDisplay}" />
                                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind SpentDisplay}" />
                                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind RemainingDisplay}" />
                                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind UtilizationDisplay}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel HorizontalAlignment="Center" Spacing="8" Visibility="{x:Bind ViewModel.AllocationsEmptyVisibility, Mode=OneWay}">
                                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource SumaBodyTextStyle}" Text="No allocations yet" />
                                        <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Add an expense category to start planning this budget." TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                                <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.DetailsLoadingVisibility, Mode=OneWay}" />
                            </Grid>
                        </Border>
                        <InfoBar IsClosable="False" IsOpen="True" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- 2. Recurring Section -->
                <Grid x:Name="RecurringSection" ColumnSpacing="28" RowSpacing="20" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="RecurringOccurrencesColDef" Width="1.1*" />
                        <ColumnDefinition x:Name="RecurringSchedulesColDef" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: Occurrences -->
                    <StackPanel x:Name="RecurringOccurrencesPanel" Grid.Column="0" Grid.Row="0" Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Recurring" />
                                <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Scheduled money movements become real only when marked paid." TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Create new recurring transaction" Click="OnNewRecurringClick" Content="New recurring" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="UpcomingOccurrencesButton" AutomationProperties.Name="Show pending recurring occurrences" Click="OnUpcomingOccurrencesClick" Content="Upcoming" Style="{StaticResource SumaNavigationItemSelectedStyle}" />
                            <ToggleButton x:Name="HistoryOccurrencesButton" AutomationProperties.Name="Show paid and skipped recurring occurrences" Click="OnHistoryOccurrencesClick" Content="History" Style="{StaticResource SumaNavigationItemStyle}" />
                        </StackPanel>
                        <Grid MinHeight="120">
                            <ListView AutomationProperties.Name="Recurring occurrences" ItemsSource="{x:Bind RecurringViewModel.Occurrences, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecurringOccurrenceRowViewModel">
                                        <Border Background="{StaticResource SumaSurfaceSecondaryBrush}" CornerRadius="{StaticResource SumaCornerLarge}" Padding="20" Margin="0,0,0,8">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind Title}" />
                                                    <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind ContextDisplay}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind DueDisplay}" />
                                                    <TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind StatusDisplay}" />
                                                    <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind TransactionDisplay}" Visibility="{x:Bind TransactionVisibility}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind AmountDisplay}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind PendingVisibility}">
                                                        <Button AutomationProperties.Name="Mark recurring occurrence paid" Click="OnMarkPaidClick" Content="Mark paid" IsEnabled="{x:Bind CanMarkPaid}" />
                                                        <Button AutomationProperties.Name="Skip recurring occurrence" Click="OnSkipOccurrenceClick" Content="Skip" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="No occurrences in this view." Visibility="{x:Bind RecurringViewModel.EmptyOccurrencesVisibility, Mode=OneWay}" />
                            <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind RecurringViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind RecurringViewModel.LoadingVisibility, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: Schedules -->
                    <StackPanel x:Name="RecurringSchedulesPanel" Grid.Column="1" Grid.Row="0" Spacing="16">
                        <Border Background="{StaticResource SumaSurfaceSecondaryBrush}" CornerRadius="{StaticResource SumaCornerLarge}" Padding="24">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Schedules" />
                                <ListView AutomationProperties.Name="Recurring schedules" ItemsSource="{x:Bind RecurringViewModel.Schedules, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RecurringScheduleRowViewModel">
                                            <Border BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,8">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind Title}" />
                                                        <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind ContextDisplay}" TextWrapping="Wrap" />
                                                        <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind PatternDisplay}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                                        <TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind AmountDisplay}" />
                                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind TypeDisplay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="No recurring schedules yet." Visibility="{x:Bind RecurringViewModel.EmptySchedulesVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <InfoBar IsClosable="False" IsOpen="True" Message="{x:Bind RecurringViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" Visibility="{x:Bind RecurringViewModel.ErrorVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>

                <!-- 3. Savings Section -->
                <Grid x:Name="SavingsSection" ColumnSpacing="28" RowSpacing="20" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SavingsListColDef" Width="380" />
                        <ColumnDefinition x:Name="SavingsDetailColDef" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: Savings Goals List -->
                    <StackPanel x:Name="SavingsListPanel" Grid.Column="0" Grid.Row="0" Spacing="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Savings goals" />
                                <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Attribute existing transactions toward goals without moving money." TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Create new savings goal" Click="OnNewSavingsGoalClick" Content="New goal" Visibility="{x:Bind SavingsViewModel.NewGoalVisibility, Mode=OneWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="ActiveSavingsButton" AutomationProperties.Name="Show active savings goals" Click="OnActiveSavingsClick" Content="Active" Style="{StaticResource SumaNavigationItemSelectedStyle}" />
                            <ToggleButton x:Name="ArchivedSavingsButton" AutomationProperties.Name="Show archived savings goals" Click="OnArchivedSavingsClick" Content="Archived" Style="{StaticResource SumaNavigationItemStyle}" />
                        </StackPanel>
                        <Grid MinHeight="140">
                            <ListView x:Name="SavingsGoalList" AutomationProperties.Name="Savings goal list" IsItemClickEnabled="True" ItemClick="OnSavingsGoalClick" ItemsSource="{x:Bind SavingsViewModel.Goals, Mode=OneWay}" SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SavingsGoalRowViewModel">
                                        <Border Background="{StaticResource SumaSurfaceSecondaryBrush}" CornerRadius="{StaticResource SumaCornerLarge}" Padding="20" Margin="0,0,0,8">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind Name}" />
                                                    <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind DestinationDisplay}" />
                                                    <ProgressBar Maximum="100" Value="{x:Bind ProgressPercent}" />
                                                    <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind StatusDisplay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="3">
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind ProgressDisplay}" />
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind TargetDisplay}" />
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind RemainingDisplay}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind SavingsViewModel.EmptyVisibility, Mode=OneWay}">
                                <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="No savings goals in this view" />
                                <Button AutomationProperties.Name="Create first savings goal" Click="OnNewSavingsGoalClick" Content="New goal" Visibility="{x:Bind SavingsViewModel.NewGoalVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <ProgressRing Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{x:Bind SavingsViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind SavingsViewModel.LoadingVisibility, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: Selected Goal Details & Contributions -->
                    <StackPanel x:Name="SavingsDetailPanel" Grid.Column="1" Grid.Row="0" Spacing="16">
                        <Border Background="{StaticResource SumaSurfaceSecondaryBrush}" CornerRadius="{StaticResource SumaCornerLarge}" Padding="24" Visibility="{x:Bind SavingsViewModel.DetailsVisibility, Mode=OneWay}">
                            <StackPanel Spacing="20">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind SavingsViewModel.SelectedGoal.Name, Mode=OneWay, FallbackValue='Goal details'}" />
                                        <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind SavingsViewModel.SelectedGoal.TargetDateDisplay, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind SavingsViewModel.SelectedGoal.DestinationDisplay, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button AutomationProperties.Name="Archive selected savings goal" Click="OnArchiveSavingsClick" Content="Archive" Visibility="{x:Bind SavingsViewModel.ArchiveVisibility, Mode=OneWay}" />
                                        <Button AutomationProperties.Name="Restore selected savings goal" Click="OnRestoreSavingsClick" Content="Restore" Visibility="{x:Bind SavingsViewModel.RestoreVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="Target" />
                                            <TextBlock Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" Text="{x:Bind SavingsViewModel.SelectedGoal.TargetDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="Progress" />
                                            <TextBlock Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" Text="{x:Bind SavingsViewModel.SelectedGoal.ProgressDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="Remaining" />
                                            <TextBlock Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" Text="{x:Bind SavingsViewModel.SelectedGoal.RemainingDisplay, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Contribution history" />
                                    <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Add savings goal contribution" Click="OnAddSavingsContributionClick" Content="Add contribution" Visibility="{x:Bind SavingsViewModel.AddContributionVisibility, Mode=OneWay}" />
                                </Grid>
                                <ListView AutomationProperties.Name="Savings contribution history" ItemsSource="{x:Bind SavingsViewModel.Contributions, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:GoalContributionRowViewModel">
                                            <Border BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                                <Grid ColumnSpacing="16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind Title}" />
                                                        <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind Description}" />
                                                        <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind Context}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                                        <TextBlock Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" Text="{x:Bind AmountDisplay}" />
                                                        <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind DateDisplay}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="No contributions yet." Visibility="{x:Bind SavingsViewModel.ContributionsEmptyVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <InfoBar IsClosable="False" IsOpen="True" Message="{x:Bind SavingsViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" Visibility="{x:Bind SavingsViewModel.ErrorVisibility, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
