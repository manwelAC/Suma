<Page
    x:Class="Suma.Desktop.Pages.Planning.PlanningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SumaBackgroundBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource SumaPagePadding}">
            <StackPanel MaxWidth="{StaticResource SumaPageContentMaxWidth}" HorizontalAlignment="Left" Spacing="{StaticResource SumaSpace20}">
                <StackPanel Spacing="{StaticResource SumaSpace8}">
                    <TextBlock Style="{StaticResource SumaPageTitleTextStyle}" Text="Planning" />
                    <TextBlock Style="{StaticResource SumaLeadTextStyle}" Text="Thoughtful planning tools will be introduced here when their workflows are ready." />
                </StackPanel>
                <Border Style="{StaticResource SumaPlaceholderSurfaceStyle}">
                    <StackPanel Spacing="{StaticResource SumaSpace8}">
                        <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Plan with intention" />
                        <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="This placeholder contains no budgets, goals, schedules, or sample financial data." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
