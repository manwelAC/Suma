<Page
    x:Class="Suma.Desktop.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SumaBackgroundBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource SumaPagePadding}">
            <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SumaPageTitleTextStyle}" Text="Settings" />
                    <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Preferences and local data controls will appear here." />
                </StackPanel>
                <Border Style="{StaticResource SumaPlaceholderSurfaceStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Designed for your device" />
                        <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Appearance, data, and security settings are intentionally deferred until their dedicated milestones." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
