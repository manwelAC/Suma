<Page
    x:Class="Suma.Desktop.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:layout="using:Suma.Desktop.Common"
    Background="{StaticResource SumaBackgroundBrush}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid Padding="{StaticResource SumaPagePadding}" MaxWidth="1200" HorizontalAlignment="Stretch" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Style="{StaticResource SumaPageTitleTextStyle}" Text="Settings" />
                <TextBlock Style="{StaticResource SumaLeadTextStyle}" Text="Security and local finance data controls." />
            </StackPanel>

            <!-- Status InfoBars -->
            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}" />
                <InfoBar IsOpen="{Binding HasSuccess}" Severity="Success" Message="{Binding SuccessMessage}" />
            </StackPanel>

            <!-- Settings Sections Grid -->
            <Grid Grid.Row="2" ColumnSpacing="28" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsRightColDef" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left Column: Security -->
                <Border Style="{StaticResource SumaPlaceholderSurfaceStyle}" Padding="28,24">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Security" />
                        <Border Background="{StaticResource SumaSurfaceBrush}" CornerRadius="{StaticResource SumaCornerMedium}" Padding="16,12">
                            <TextBlock x:Name="PinStatusText" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="PIN locks Suma on this Windows device. It does not encrypt your finance database. Suma has no online PIN recovery." />

                        <!-- Enable PIN Form -->
                        <StackPanel x:Name="EnablePanel" Spacing="12">
                            <PasswordBox x:Name="NewPinBox" Header="New PIN" PlaceholderText="4–6 numeric digits" PasswordChar="●" />
                            <PasswordBox x:Name="ConfirmPinBox" Header="Confirm new PIN" PasswordChar="●" />
                            <Button HorizontalAlignment="Left" Content="Enable PIN" IsEnabled="{Binding CanEnablePin}" Click="OnEnablePin" />
                        </StackPanel>

                        <!-- Change / Disable PIN Form -->
                        <StackPanel x:Name="EnabledPanel" Spacing="12">
                            <PasswordBox x:Name="CurrentPinBox" Header="Current PIN" PasswordChar="●" />
                            <PasswordBox x:Name="ChangedPinBox" Header="New PIN" PlaceholderText="4–6 numeric digits" PasswordChar="●" />
                            <PasswordBox x:Name="ChangedConfirmBox" Header="Confirm new PIN" PasswordChar="●" />
                            <layout:WrapPanel Spacing="8" Margin="0,4,0,0">
                                <Button Content="Change PIN" IsEnabled="{Binding CanChangePin}" Click="OnChangePin" />
                                <Button Content="Disable PIN" IsEnabled="{Binding CanDisablePin}" Click="OnDisablePin" />
                            </layout:WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: Local Data & Backups -->
                <Border x:Name="LocalDataPanel" Grid.Column="1" Grid.Row="0" Style="{StaticResource SumaPlaceholderSurfaceStyle}" Padding="28,24" VerticalAlignment="Top">
                    <StackPanel Spacing="16">
                        <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Local data" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Backups contain your finance database but not your device PIN. Restore replaces your current Suma financial data; your local PIN setting will not change." />
                        <layout:WrapPanel Spacing="8" Margin="0,4,0,0">
                            <Button Content="Create Backup" IsEnabled="{Binding CanManageData}" Click="OnBackup" />
                            <Button Content="Restore Backup" IsEnabled="{Binding CanManageData}" Click="OnRestore" />
                        </layout:WrapPanel>

                        <!-- Reset / Erase Financial Data -->
                        <Border BorderBrush="#FFE5C4C4" BorderThickness="1" CornerRadius="10" Background="#FFFDF7F7" Padding="16,14" Margin="0,8,0,0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="Erase all data" FontWeight="SemiBold" FontSize="13" Foreground="#FF9E2A2B" />
                                    <TextBlock Text="Permanently delete all accounts, transactions, and budgets to start fresh." FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Reset Data" Click="OnResetData" IsEnabled="{Binding CanManageData}" Background="#FFFCE8E8" Foreground="#FF9E2A2B" BorderBrush="#FFDEAAAA" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="RestartText" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource SumaCaptionTextStyle}" Text="Close Suma and open it again to finish Restore." />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
