<Page
    x:Class="Suma.Desktop.Pages.Activity.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:layout="using:Suma.Desktop.Common"
    xmlns:models="using:Suma.Desktop.ViewModels"
    Background="{StaticResource SumaBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="ActivityCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SumaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SumaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="MinHeight" Value="136" />
        </Style>

        <Style x:Key="ActivityToolbarFilterStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource SumaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SumaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="Background" Value="{StaticResource SumaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SumaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="DetailHeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource SumaSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource SumaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Deep Forest Green Primary Action Button (Add transaction) -->
        <Style x:Key="ActivityPrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#264E36" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="#1E3F2B" />
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFFFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="#162E20" />
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFE0E0E0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Deep Forest Green Attached Search Button -->
        <Style x:Key="ActivitySearchAttachedButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#264E36" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0,8,8,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Background="{TemplateBinding Background}"
                            Foreground="{TemplateBinding Foreground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="#1E3F2B" />
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFFFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Background" Value="#162E20" />
                                            <Setter Target="ContentPresenter.Foreground" Value="#FFE0E0E0" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="ContentPresenter.Opacity" Value="0.45" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ContentPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="PageLayout" Padding="36,24,36,32" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="500" />
            </Grid.RowDefinitions>

            <!-- Panoramic Atmospheric Background Landscape with Seamless Edge Fades Behind Cards -->
            <Grid x:Name="LandscapeCanvas" Grid.Row="0" Grid.RowSpan="4" Margin="-36,-24,-36,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="460" IsHitTestVisible="False">
                <!-- Warm ambient morning sun & radiant atmospheric haze in top-right -->
                <Ellipse Width="540" Height="320" Fill="#208FA28C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,10,0" />
                <Ellipse Width="360" Height="240" Fill="#307A8E7C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,80,0" />
                <Ellipse Width="170" Height="170" Fill="#4C8FA28C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,170,0" />

                <!-- Left atmospheric mist -->
                <Ellipse Width="420" Height="260" Fill="#1A4A624E" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,-20,0,0" />

                <!-- Flying cranes in the serene sky -->
                <Canvas HorizontalAlignment="Right" VerticalAlignment="Top" Width="300" Height="100" Margin="0,30,360,0">
                    <Path Data="M 10,40 Q 20,30 30,40 Q 40,30 50,40" Stroke="#5A556B5A" StrokeThickness="2" />
                    <Path Data="M 52,24 Q 60,16 68,24 Q 76,16 84,24" Stroke="#4A556B5A" StrokeThickness="1.6" />
                    <Path Data="M 80,48 Q 87,42 94,48 Q 101,42 108,48" Stroke="#3E556B5A" StrokeThickness="1.4" />
                </Canvas>

                <!-- Layer 1: Distant majestic mountain ridge (farthest, tall peaks) -->
                <Path Data="M 0,340 C 180,240 380,280 620,180 C 850,100 1100,200 1350,130 C 1600,70 1850,170 2100,120 L 2100,460 L 0,460 Z" Fill="#2F667A68" VerticalAlignment="Bottom" Stretch="Fill" Height="340" />

                <!-- Layer 2: Mid-ground rolling mountain range -->
                <Path Data="M 0,380 C 220,270 480,330 780,220 C 1050,140 1350,250 1620,180 C 1850,130 2000,190 2100,170 L 2100,460 L 0,460 Z" Fill="#44556C58" VerticalAlignment="Bottom" Stretch="Fill" Height="280" />

                <!-- Layer 3: Foreground lush rolling knolls -->
                <Path Data="M 0,400 C 280,300 600,240 920,310 C 1220,340 1520,240 1820,280 C 1960,295 2040,265 2100,275 L 2100,460 L 0,460 Z" Fill="#58435A47" VerticalAlignment="Bottom" Stretch="Fill" Height="210" />

                <!-- Stylized trees on ridges -->
                <Canvas VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="300" Width="440">
                    <!-- Right Ridge Trees -->
                    <Ellipse Width="18" Height="42" Fill="#72364C3B" Canvas.Left="180" Canvas.Top="125" />
                    <Rectangle Width="2" Height="16" Fill="#85303D32" Canvas.Left="188" Canvas.Top="157" />

                    <Ellipse Width="24" Height="52" Fill="#7D364C3B" Canvas.Left="228" Canvas.Top="130" />
                    <Rectangle Width="2.5" Height="18" Fill="#85303D32" Canvas.Left="239" Canvas.Top="170" />

                    <Ellipse Width="16" Height="36" Fill="#66364C3B" Canvas.Left="295" Canvas.Top="115" />
                    <Rectangle Width="2" Height="14" Fill="#85303D32" Canvas.Left="302" Canvas.Top="143" />

                    <Ellipse Width="20" Height="46" Fill="#75364C3B" Canvas.Left="340" Canvas.Top="138" />
                    <Rectangle Width="2" Height="16" Fill="#85303D32" Canvas.Left="349" Canvas.Top="174" />
                </Canvas>

                <!-- Left Ridge Trees -->
                <Canvas VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="300" Width="300">
                    <Ellipse Width="18" Height="40" Fill="#68364C3B" Canvas.Left="80" Canvas.Top="150" />
                    <Rectangle Width="2" Height="14" Fill="#85303D32" Canvas.Left="88" Canvas.Top="182" />

                    <Ellipse Width="22" Height="48" Fill="#72364C3B" Canvas.Left="120" Canvas.Top="142" />
                    <Rectangle Width="2" Height="16" Fill="#85303D32" Canvas.Left="130" Canvas.Top="180" />
                </Canvas>

                <!-- Multi-stop Vertical Fade Overlay: Keeps top vivid, melts seamlessly into page background (#FFF8F7F3) at bottom -->
                <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00F8F7F3" Offset="0.0" />
                            <GradientStop Color="#00F8F7F3" Offset="0.52" />
                            <GradientStop Color="#2AF8F7F3" Offset="0.68" />
                            <GradientStop Color="#85F8F7F3" Offset="0.84" />
                            <GradientStop Color="#FAF8F7F3" Offset="0.97" />
                            <GradientStop Color="#FFF8F7F3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Left Soft Feathering: Melts outer edges seamlessly -->
                <Rectangle HorizontalAlignment="Left" Width="120" VerticalAlignment="Stretch">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#50F8F7F3" Offset="0.0" />
                            <GradientStop Color="#00F8F7F3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Right Soft Feathering -->
                <Rectangle HorizontalAlignment="Right" Width="120" VerticalAlignment="Stretch">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                            <GradientStop Color="#50F8F7F3" Offset="0.0" />
                            <GradientStop Color="#00F8F7F3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>

            <!-- Row 0: Header -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderTitleColumn" Width="*" />
                    <ColumnDefinition x:Name="HeaderActionsColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="Activity" />
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Browse, search, and manage your transactions." />
                </StackPanel>

                <layout:WrapPanel x:Name="HeaderActions" Grid.Column="1" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Currency" VerticalAlignment="Center" />
                        <ComboBox Height="36" MinWidth="100" CornerRadius="8" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" ItemsSource="{x:Bind ViewModel.Currencies, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=OneWay}" SelectionChanged="OnCurrencySelectionChanged" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Height="36" CornerRadius="8" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" Padding="14,0" AutomationProperties.Name="Refresh activity" Click="OnRefreshClick" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="Refresh" />
                        </StackPanel>
                    </Button>
                </layout:WrapPanel>
            </Grid>

            <!-- Row 1: 4 Metric Cards -->
            <Grid x:Name="SummaryGrid" Grid.Row="1" ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="100*" />
                    <ColumnDefinition Width="80*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <!-- Income Card -->
                <Border x:Name="IncomeCard" Style="{StaticResource ActivityCardStyle}">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SumaTextSecondaryBrush}" CharacterSpacing="40" Text="INCOME IN VIEW" />
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#2E7D32" Text="{x:Bind ViewModel.IncomeDisplay, Mode=OneWay}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Actual ledger income" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" CornerRadius="17" Background="#EDF5EE">
                            <FontIcon Glyph="&#xE74A;" FontSize="15" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Expense Card -->
                <Border x:Name="ExpenseCard" Grid.Column="1" Style="{StaticResource ActivityCardStyle}">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SumaTextSecondaryBrush}" CharacterSpacing="40" Text="EXPENSES IN VIEW" />
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#C74B3E" Text="{x:Bind ViewModel.ExpenseDisplay, Mode=OneWay}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Before refunds" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" CornerRadius="17" Background="#FDEEEC">
                            <FontIcon Glyph="&#xE74B;" FontSize="15" Foreground="#C74B3E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Net Flow Card -->
                <Border x:Name="NetCard" Grid.Column="2" Style="{StaticResource ActivityCardStyle}">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SumaTextSecondaryBrush}" CharacterSpacing="40" Text="NET FLOW IN VIEW" />
                            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#2E7D32" Text="{x:Bind ViewModel.NetFlowDisplay, Mode=OneWay}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Income − expenses + refunds" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" CornerRadius="17" Background="#EDF5EE">
                            <FontIcon Glyph="&#xE9D2;" FontSize="15" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Count Card -->
                <Border x:Name="CountCard" Grid.Column="3" Style="{StaticResource ActivityCardStyle}">
                    <Grid>
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SumaTextSecondaryBrush}" CharacterSpacing="40" Text="TRANSACTIONS" />
                            <TextBlock FontSize="28" FontWeight="Bold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.Items.Count, Mode=OneWay}" />
                        </StackPanel>

                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="34" Height="34" CornerRadius="17" Background="#EDF5EE">
                            <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 2: Filter & Action Toolbar -->
            <Grid x:Name="ToolbarGrid" Grid.Row="2" ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="0" />
                </Grid.RowDefinitions>

                <!-- Date Range Selector -->
                <Button x:Name="DateRangeButton" Grid.Column="0" Height="40" HorizontalAlignment="Stretch" CornerRadius="8" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" Padding="12,0" Click="OnDateRangeClick">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE787;" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedDateRange, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SumaTextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout x:Name="DateRangeFlyout">
                            <StackPanel Spacing="10" Width="260" Padding="4">
                                <TextBlock Text="Date Range" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                <StackPanel Spacing="2">
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6" Content="All time" Click="OnDateRangePresetSelected" Tag="All time" />
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6" Content="This month" Click="OnDateRangePresetSelected" Tag="This month" />
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6" Content="Last month" Click="OnDateRangePresetSelected" Tag="Last month" />
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6" Content="Last 30 days" Click="OnDateRangePresetSelected" Tag="Last 30 days" />
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6" Content="Last 90 days" Click="OnDateRangePresetSelected" Tag="Last 90 days" />
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="10,6" CornerRadius="6" Content="This year" Click="OnDateRangePresetSelected" Tag="This year" />
                                </StackPanel>
                                <Rectangle Height="1" Fill="{StaticResource SumaBorderBrush}" Margin="0,2" />
                                <TextBlock Text="Custom Range" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                                <CalendarDatePicker x:Name="StartDatePicker" Header="From" HorizontalAlignment="Stretch" DateFormat="{}{month.abbreviated} {day.integer}, {year.full}" />
                                <CalendarDatePicker x:Name="EndDatePicker" Header="To" HorizontalAlignment="Stretch" DateFormat="{}{month.abbreviated} {day.integer}, {year.full}" />
                                <Button Content="Apply range" HorizontalAlignment="Stretch" Height="36" Background="#264E36" Foreground="White" FontWeight="SemiBold" CornerRadius="6" Click="OnApplyCustomDateRangeClick" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Category Filter -->
                <ComboBox x:Name="CategoryFilter" Grid.Column="1" Style="{StaticResource ActivityToolbarFilterStyle}" PlaceholderText="All categories" ItemsSource="{x:Bind ViewModel.Categories, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCategory, Mode=OneWay}" SelectionChanged="OnCategorySelectionChanged" />

                <!-- Account Filter -->
                <ComboBox x:Name="AccountFilter" Grid.Column="2" Style="{StaticResource ActivityToolbarFilterStyle}" PlaceholderText="All accounts" ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedAccount, Mode=OneWay}" SelectionChanged="OnAccountSelectionChanged" />

                <!-- Type Filter -->
                <ComboBox x:Name="TypeFilter" Grid.Column="3" Style="{StaticResource ActivityToolbarFilterStyle}" SelectedIndex="0" SelectionChanged="OnTypeSelectionChanged">
                    <ComboBoxItem Content="All types" Tag="All" />
                    <ComboBoxItem Content="Expenses" Tag="Expense" />
                    <ComboBoxItem Content="Income" Tag="Income" />
                    <ComboBoxItem Content="Transfers" Tag="Transfer" />
                    <ComboBoxItem Content="Refunds" Tag="Refund" />
                </ComboBox>

                <!-- Search Field with Attached Search Button -->
                <Grid x:Name="SearchContainer" Grid.Column="4" Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="40" CornerRadius="8,0,0,8" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1,1,0,1">
                        <TextBox x:Name="SearchBox"
                            Height="38"
                            MinHeight="0"
                            FontSize="13"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="14,9,8,9"
                            Background="Transparent"
                            BorderThickness="0"
                            PlaceholderText="Search transactions"
                            KeyDown="OnSearchBoxKeyDown"
                            TextChanged="OnSearchBoxTextChanged"
                            AutomationProperties.Name="Search transactions">
                            <TextBox.Resources>
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource ActivitySearchAttachedButtonStyle}" Click="OnSearchButtonClick" AutomationProperties.Name="Execute search">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" FontSize="12" Foreground="White" />
                            <TextBlock Text="Search" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Add Transaction Split / Action Button -->
                <Button x:Name="AddTransactionButton" Grid.Column="5" Style="{StaticResource ActivityPrimaryActionButtonStyle}" AutomationProperties.Name="Add transaction" Click="OnAddTransactionClick">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="White" />
                        <TextBlock Text="Add transaction" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                        <Rectangle Width="1" Height="16" Fill="#55FFFFFF" Margin="4,0" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Row 3: Info & Error Bar -->
            <InfoBar Grid.Row="3" IsClosable="False" IsOpen="True" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" CornerRadius="10" />

            <!-- Row 4: Workspace 2-Column Ledger & Details -->
            <Grid x:Name="WorkspaceGrid" Grid.Row="4" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LedgerColumn" Width="1.55*" />
                    <ColumnDefinition x:Name="DetailColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="CompactDetailRow" Height="0" />
                </Grid.RowDefinitions>

                <!-- Left Panel: Recent Transactions Card -->
                <Border x:Name="LedgerPanel" Grid.Column="0" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0" MinHeight="420">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Panel Header -->
                        <Grid Padding="24,18,24,14" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="Recent transactions" VerticalAlignment="Center" />

                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6,4" Click="OnToggleSortClick" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind ViewModel.SortOrderDisplay, Mode=OneWay}" />
                                    <FontIcon Glyph="&#xE8CB;" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Transaction List -->
                        <Grid Grid.Row="1">
                            <ListView x:Name="TransactionList" AutomationProperties.Name="Transaction history" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}" SelectionMode="Single" Opacity="{x:Bind ViewModel.ListOpacity, Mode=OneWay}">
                                <ListView.Resources>
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#FFF0F5EE" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#FFE7EFE5" />
                                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#FFDEE8DC" />
                                    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#FF1C1C1E" />
                                </ListView.Resources>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="10,2" />
                                        <Setter Property="CornerRadius" Value="10" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ActivityRowViewModel">
                                        <StackPanel>
                                            <!-- Date Group Header -->
                                            <TextBlock Margin="14,14,14,6" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind DateGroupLabel}" Visibility="{x:Bind DateGroupVisibility}" />

                                            <!-- Transaction Item Row -->
                                            <Grid MinHeight="56" Padding="14,8" ColumnSpacing="12" BorderBrush="#FFF3F2EE" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="82" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Category Icon Circle -->
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{x:Bind IconBackground}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" Foreground="{x:Bind IconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Date column with subtle repeat / status indicator -->
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind DateDisplay}" TextTrimming="CharacterEllipsis" />

                                                <!-- Title and Subtitle / Context -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind Context}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <!-- Category Pill Badge -->
                                                <Border Grid.Column="3" VerticalAlignment="Center" Margin="4,0" Padding="10,3" CornerRadius="12" Background="{x:Bind CategoryBadgeBackground}">
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind CategoryBadgeForeground}" Text="{x:Bind CategoryDisplay}" />
                                                </Border>

                                                <!-- Account Badge -->
                                                <Grid Grid.Column="4" VerticalAlignment="Center" Margin="4,0">
                                                    <!-- Non-Transfer Account Badge -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind NonTransferVisibility}">
                                                        <Border Width="18" Height="18" CornerRadius="4" Background="{x:Bind PrimaryAccountBadgeBg}" VerticalAlignment="Center">
                                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind PrimaryAccountBadgeText}" />
                                                        </Border>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind PrimaryAccountName}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Transfer Dual-Account Badge -->
                                                    <StackPanel Orientation="Horizontal" Spacing="5" Visibility="{x:Bind TransferArrowsVisibility}">
                                                        <Border Width="18" Height="18" CornerRadius="4" Background="{x:Bind PrimaryAccountBadgeBg}" VerticalAlignment="Center">
                                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind PrimaryAccountBadgeText}" />
                                                        </Border>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind PrimaryAccountName}" VerticalAlignment="Center" />
                                                        <TextBlock FontSize="11" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="→" VerticalAlignment="Center" Margin="1,0" />
                                                        <Border Width="18" Height="18" CornerRadius="4" Background="{x:Bind TargetAccountBadgeBg}" VerticalAlignment="Center">
                                                            <TextBlock FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind TargetAccountBadgeText}" />
                                                        </Border>
                                                        <TextBlock FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind TargetAccountName}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Amount Column -->
                                                <Grid Grid.Column="5" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Text="{x:Bind FormattedRowAmount}" Visibility="{x:Bind IncomeVisibility}" />
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind FormattedRowAmount}" Visibility="{x:Bind ExpenseVisibility}" />
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="#2E7D32" Text="{x:Bind FormattedRowAmount}" Visibility="{x:Bind RefundVisibility}" />
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind FormattedRowAmount}" Visibility="{x:Bind TransferVisibility}" />
                                                </Grid>

                                                <!-- Trailing Chevron -->
                                                <FontIcon Grid.Column="6" Glyph="&#xE76C;" FontSize="11" Foreground="#8E8E93" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Empty State -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                                <FontIcon Glyph="&#xE9D9;" FontSize="30" Foreground="{StaticResource SumaAccentBrush}" />
                                <TextBlock HorizontalAlignment="Center" Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
                                <TextBlock TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Transactions matching this view will appear here." />
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <Button HorizontalAlignment="Center" Click="OnResetFiltersClick" Content="Reset filters" Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}" />
                                    <Button HorizontalAlignment="Center" Click="OnAddTransactionClick" Content="Add transaction" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Polished Table Loading State Overlay -->
                            <Grid x:Name="TableLoadingOverlay" Visibility="{x:Bind ViewModel.BusyVisibility, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                                <Border Background="#EEFFFFFF" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Foreground="#264E36" />
                                        <TextBlock Text="{x:Bind ViewModel.LoadingStatusText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Panel Footer: View more transactions -->
                        <Button Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,14" Background="Transparent" BorderThickness="0" Click="OnViewMoreClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="View more transactions" />
                                <FontIcon Glyph="&#xE70D;" FontSize="10" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right Panel: Transaction Details Card -->
                <Border x:Name="DetailPanel" Grid.Column="1" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24" MinHeight="420">
                    <Grid>
                        <!-- Empty Selection State -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.DetailEmptyVisibility, Mode=OneWay}">
                            <Image Source="ms-appx:///Assets/Mascot/sumowave.png" Width="96" Height="96" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,0,6" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SumaSectionTitleTextStyle}" Text="Select a transaction" />
                            <TextBlock TextWrapping="Wrap" MaxWidth="260" TextAlignment="Center" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Choose an item from your activity to view its details." />
                        </StackPanel>

                        <!-- Selected Transaction Details Content -->
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                            <!-- Header with Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="Transaction details" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Style="{StaticResource DetailHeaderActionButtonStyle}" Click="OnEditTransactionClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                            <TextBlock Text="Edit" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource DetailHeaderActionButtonStyle}" Click="OnDuplicateTransactionClick">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="11" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                            <TextBlock Text="Duplicate" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Width="34" Height="34" CornerRadius="8" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" Padding="0">
                                        <FontIcon Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Copy ID" Click="OnCopyIdClick" />
                                                <MenuFlyoutItem Text="Delete transaction" Click="OnDeleteTransactionClick" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Hero Header: Category Icon, Title, Subtitle, and Amount -->
                            <Grid ColumnSpacing="14" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="24" Background="{x:Bind ViewModel.SelectedItem.IconBackground, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <FontIcon Glyph="{x:Bind ViewModel.SelectedItem.IconGlyph, Mode=OneWay}" FontSize="20" Foreground="{x:Bind ViewModel.SelectedItem.IconForeground, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.Title, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedItem.Context, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                    <TextBlock FontSize="19" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.FormattedDetailAmount, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="{x:Bind ViewModel.SelectedItem.TypeDisplay, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- Subtle Divider -->
                            <Rectangle Height="1" Fill="#FFEAE8E3" Margin="0,4" />

                            <!-- Metadata Table -->
                            <Grid ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="135" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Date -->
                                <TextBlock FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Date" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.DateTimeDisplay, Mode=OneWay}" VerticalAlignment="Center" />

                                <!-- Category -->
                                <TextBlock Grid.Row="1" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Category" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{x:Bind ViewModel.SelectedItem.CategoryBadgeForeground, Mode=OneWay}" VerticalAlignment="Center" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.CategoryDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Account -->
                                <TextBlock Grid.Row="2" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Account" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Width="16" Height="16" CornerRadius="3" Background="{x:Bind ViewModel.SelectedItem.PrimaryAccountBadgeBg, Mode=OneWay}" VerticalAlignment="Center">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Bind ViewModel.SelectedItem.PrimaryAccountBadgeText, Mode=OneWay}" />
                                    </Border>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.PrimaryAccountName, Mode=OneWay}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Payment Method -->
                                <TextBlock Grid.Row="3" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Payment method" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" FontSize="13" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.PaymentMethodDisplay, Mode=OneWay}" VerticalAlignment="Center" />

                                <!-- Status -->
                                <TextBlock Grid.Row="4" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Status" VerticalAlignment="Center" />
                                <Border Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Padding="8,3" CornerRadius="10" Background="#EDF5EE">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" Text="{x:Bind ViewModel.SelectedItem.StatusDisplay, Mode=OneWay}" />
                                </Border>

                                <!-- Reference / Receipt -->
                                <TextBlock Grid.Row="5" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Reference / Receipt" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="1" FontSize="13" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.ReferenceCode, Mode=OneWay}" VerticalAlignment="Center" />

                                <!-- Notes -->
                                <TextBlock Grid.Row="6" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Notes" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock Grid.Row="6" Grid.Column="1" FontSize="13" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="{x:Bind ViewModel.SelectedItem.NotesDisplay, Mode=OneWay}" TextWrapping="Wrap" />

                                <!-- Tags -->
                                <TextBlock Grid.Row="7" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Tags" VerticalAlignment="Center" />
                                <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Padding="10,3" CornerRadius="10" Background="#F1F5F9">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#475569" Text="{x:Bind ViewModel.SelectedItem.TagDisplay, Mode=OneWay}" />
                                    </Border>
                                    <Button Background="Transparent" BorderThickness="0" Padding="6,2" Click="OnAddTagClick">
                                        <TextBlock FontSize="11" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="+ Add tag" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Quick Actions Card -->
                            <Border Margin="0,10,0,0" Padding="16,14" Background="#F5F8F4" BorderBrush="#E2EADF" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="12">
                                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{StaticResource SumaTextPrimaryBrush}" Text="Quick actions" />

                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <!-- Add to budget -->
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionAddToBudget">
                                                    <FontIcon Glyph="&#xEB3C;" FontSize="15" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                                </Button>
                                                <TextBlock FontSize="10" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Add to budget" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Split transaction -->
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionSplit">
                                                    <FontIcon Glyph="&#xE8AB;" FontSize="15" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                                </Button>
                                                <TextBlock FontSize="10" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Split transaction" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Mark as recurring -->
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionRecurring">
                                                    <FontIcon Glyph="&#xE823;" FontSize="15" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                                </Button>
                                                <TextBlock FontSize="10" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Mark as recurring" HorizontalAlignment="Center" />
                                            </StackPanel>

                                            <!-- Export receipt -->
                                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource QuickActionButtonStyle}" Click="OnQuickActionExportReceipt">
                                                    <FontIcon Glyph="&#xE896;" FontSize="15" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                                </Button>
                                                <TextBlock FontSize="10" Foreground="{StaticResource SumaTextSecondaryBrush}" Text="Export receipt" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Sumo Checklist Mascot on the right -->
                                    <Image Grid.Column="1" Source="ms-appx:///Assets/Mascot/checklist.png" Width="76" Height="76" HorizontalAlignment="Right" VerticalAlignment="Center" Stretch="Uniform" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

