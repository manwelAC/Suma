<Page x:Class="Suma.Desktop.Pages.Recovery.RecoveryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource SumaBackgroundBrush}">
    <Grid Padding="32"><StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><TextBlock Style="{StaticResource SumaPageTitleTextStyle}" Text="Suma needs recovery"/><InfoBar IsOpen="True" IsClosable="False" Severity="Error" Title="Finance data was not opened" Message="{x:Bind Message, Mode=OneTime}"/><TextBlock TextWrapping="Wrap" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Close Suma and preserve its local data. Do not retry Restore until the recovery state has been resolved."/></StackPanel></Grid>
</Page>
