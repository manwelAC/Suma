<Page
    x:Class="Suma.Desktop.Pages.Overview.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Suma.Desktop.ViewModels"
    Background="{StaticResource SumaBackgroundBrush}">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="RootGrid" Padding="36,28,36,32" MaxWidth="1600" HorizontalAlignment="Stretch" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" ColumnSpacing="20" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HeaderTitleColDef" Width="*" />
                    <ColumnDefinition x:Name="HeaderControlsColDef" Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="HeaderSecondRowDef" Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="Overview" FontFamily="Segoe UI Variable Display" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                    <TextBlock Text="A clear view of what is available today." Style="{StaticResource SumaLeadTextStyle}" />
                </StackPanel>

                <StackPanel x:Name="HeaderControlsStack" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Currency" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" Margin="0,0,4,0" />
                    <ComboBox x:Name="CurrencySelector" MinWidth="110" Height="38" CornerRadius="8" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" ItemsSource="{x:Bind ViewModel.Currencies, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=OneWay}" SelectionChanged="OnCurrencySelectionChanged" VerticalAlignment="Center" />
                    <Button Click="OnRefreshClick" Height="38" CornerRadius="8" Background="{StaticResource SumaSurfaceBrush}" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1" Padding="14,0,14,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                            <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Row 1: Status & Alerts -->
            <StackPanel Grid.Row="1" Spacing="8">
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" Foreground="{StaticResource SumaAccentBrush}" Height="3" />
                <InfoBar IsOpen="True" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" CornerRadius="10" />
            </StackPanel>

            <!-- Row 2: Available to Spend Hero Card -->
            <Border Grid.Row="2" CornerRadius="16" BorderThickness="1" BorderBrush="#FFD6E2D3">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
                        <GradientStop Color="#FFF3F7F2" Offset="0" />
                        <GradientStop Color="#FFE8EFE5" Offset="0.55" />
                        <GradientStop Color="#FFDFEADB" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition x:Name="HeroArtColDef" Width="*" MaxWidth="440" />
                    </Grid.ColumnDefinitions>

                    <!-- Left ATS Content -->
                    <StackPanel Grid.Column="0" Padding="36,32,24,32" Spacing="10">
                        <TextBlock Text="AVAILABLE TO SPEND" FontSize="11" FontWeight="Bold" Foreground="#FF4C634A" CharacterSpacing="60" />
                        <TextBlock Text="{x:Bind ViewModel.AvailableToSpendDisplay, Mode=OneWay}" FontFamily="Segoe UI Variable Display" FontSize="44" FontWeight="Bold" Foreground="#FF182B17" />
                        <TextBlock Text="Included account balances minus protected budget remaining." FontSize="13" Foreground="#FF4A5F48" Margin="0,0,0,12" />

                        <StackPanel Orientation="Horizontal" Spacing="40">
                            <!-- Included Balance Stat -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#FF4A7C59" VerticalAlignment="Center" />
                                    <TextBlock Text="INCLUDED BALANCE" FontSize="11" FontWeight="Bold" Foreground="#FF5D725B" CharacterSpacing="40" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.IncludedBalanceDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#FF182B17" />
                            </StackPanel>

                            <!-- Protected Budget Stat -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7" Fill="#FF9AAFA0" VerticalAlignment="Center" />
                                    <TextBlock Text="PROTECTED BUDGET" FontSize="11" FontWeight="Bold" Foreground="#FF5D725B" CharacterSpacing="40" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.ProtectedReserveDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#FF182B17" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Subtle Vector Landscape Artwork with Soft Fade -->
                    <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="460">
                        <!-- Translucent glowing sun -->
                        <Ellipse Width="120" Height="120" Fill="#24FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,90,0" />

                        <!-- Rolling hills layered vector paths starting smoothly from baseline Y=240 -->
                        <Path Data="M 0,240 C 90,240 160,110 260,110 Q 360,110 460,70 L 460,240 Z" Fill="#1E6F806D" VerticalAlignment="Bottom" Stretch="Fill" Height="130" />
                        <Path Data="M 20,240 C 120,240 190,140 290,140 Q 380,140 460,95 L 460,240 Z" Fill="#2A6F806D" VerticalAlignment="Bottom" Stretch="Fill" Height="105" />
                        <Path Data="M 40,240 C 140,240 220,165 310,165 Q 390,165 460,120 L 460,240 Z" Fill="#3C6F806D" VerticalAlignment="Bottom" Stretch="Fill" Height="80" />

                        <!-- Subtle trees -->
                        <Canvas VerticalAlignment="Bottom" Height="160" Width="460">
                            <!-- Tree 1 -->
                            <Ellipse Width="16" Height="32" Fill="#556F806D" Canvas.Left="280" Canvas.Top="70" />
                            <Rectangle Width="2" Height="14" Fill="#77556054" Canvas.Left="287" Canvas.Top="94" />

                            <!-- Tree 2 -->
                            <Ellipse Width="20" Height="40" Fill="#666F806D" Canvas.Left="320" Canvas.Top="75" />
                            <Rectangle Width="2" Height="16" Fill="#77556054" Canvas.Left="329" Canvas.Top="105" />

                            <!-- Tree 3 -->
                            <Ellipse Width="14" Height="28" Fill="#446F806D" Canvas.Left="370" Canvas.Top="60" />
                            <Rectangle Width="2" Height="12" Fill="#77556054" Canvas.Left="376" Canvas.Top="82" />

                            <!-- Tree 4 -->
                            <Ellipse Width="18" Height="36" Fill="#556F806D" Canvas.Left="400" Canvas.Top="80" />
                            <Rectangle Width="2" Height="14" Fill="#77556054" Canvas.Left="408" Canvas.Top="108" />
                        </Canvas>

                        <!-- Soft feather/fade gradient overlay on the left of the artwork -->
                        <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFE8EFE5" Offset="0.0" />
                                    <GradientStop Color="#DDE8EFE5" Offset="0.15" />
                                    <GradientStop Color="#77E8EFE5" Offset="0.45" />
                                    <GradientStop Color="#00E8EFE5" Offset="0.80" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Grid>
                </Grid>
            </Border>

            <!-- Row 3: Mid Dashboard 3-Card Grid (Accounts | Current Budget | Savings Goals) -->
            <Grid x:Name="MidDashboardGrid" Grid.Row="3" ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MidCol0" Width="*" />
                    <ColumnDefinition x:Name="MidCol1" Width="*" />
                    <ColumnDefinition x:Name="MidCol2" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="MidRow0" Height="Auto" />
                    <RowDefinition x:Name="MidRow1" Height="Auto" />
                    <RowDefinition x:Name="MidRow2" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Accounts Card -->
                <Border x:Name="AccountsCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource SumaDashboardCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Accounts" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Click="OnViewAccountsClick" HorizontalAlignment="Right" Content="View all" Style="{StaticResource SumaTextSubtleButtonStyle}" />
                        </Grid>

                        <!-- Body: List of accounts -->
                        <StackPanel Grid.Row="1" Spacing="4">
                            <!-- Empty State -->
                            <StackPanel Visibility="{x:Bind ViewModel.AccountsEmptyVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20" Spacing="8">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#FFEBF2E9" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="20" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No accounts yet" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Add an account to begin tracking your money." FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Account Items -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}" Visibility="{x:Bind ViewModel.AccountsContentVisibility, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OverviewAccountRow">
                                        <Border BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon badge -->
                                                <Border Width="36" Height="36" CornerRadius="8" Background="#FFEBF2E9" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Initial}" FontSize="15" FontWeight="Bold" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Name and Status -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind StatusDisplay}" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- Balance -->
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" Text="{x:Bind BalanceDisplay}" />

                                                <!-- Chevron -->
                                                <FontIcon Grid.Column="3" Glyph="&#xE76E;" FontSize="10" Foreground="#FFC7C7CC" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Footer Action -->
                        <Button Grid.Row="2" Click="OnViewAccountsClick" HorizontalAlignment="Stretch" Height="40" CornerRadius="10" Background="Transparent" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{StaticResource SumaAccentBrush}" />
                                <TextBlock Text="Add account" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaAccentBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Current Budget Card -->
                <Border x:Name="BudgetCard" Grid.Column="1" Grid.Row="0" Style="{StaticResource SumaDashboardCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Current Budget" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Click="OnViewPlanningClick" HorizontalAlignment="Right" Content="View details" Style="{StaticResource SumaTextSubtleButtonStyle}" Visibility="{x:Bind ViewModel.CurrentBudgetContentVisibility, Mode=OneWay}" />
                        </Grid>

                        <!-- Body: Empty or Active State -->
                        <Grid Grid.Row="1">
                            <!-- Empty State (Matches visual reference mockup) -->
                            <StackPanel Visibility="{x:Bind ViewModel.CurrentBudgetEmptyVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12" Spacing="8">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#FFEBF2E9" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE8C7;" FontSize="24" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No current budget" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No protected allocations&#x0a;for this currency." FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Active Budget State -->
                            <StackPanel Visibility="{x:Bind ViewModel.CurrentBudgetContentVisibility, Mode=OneWay}" VerticalAlignment="Center" Spacing="10" Margin="0,12">
                                <TextBlock Text="{x:Bind ViewModel.BudgetTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.BudgetDetail, Mode=OneWay}" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Footer Action -->
                        <Button Grid.Row="2" Click="OnViewPlanningClick" HorizontalAlignment="Stretch" Height="40" CornerRadius="10" Background="Transparent" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1">
                            <TextBlock Text="Create budget" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Savings Goals Card -->
                <Border x:Name="SavingsCard" Grid.Column="2" Grid.Row="0" Style="{StaticResource SumaDashboardCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Savings Goals" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Click="OnViewPlanningClick" HorizontalAlignment="Right" Content="View all" Style="{StaticResource SumaTextSubtleButtonStyle}" />
                        </Grid>

                        <!-- Body: Empty or Active State -->
                        <Grid Grid.Row="1">
                            <!-- Empty State (Matches visual reference mockup) -->
                            <StackPanel Visibility="{x:Bind ViewModel.SavingsEmptyVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,12" Spacing="8">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#FFEBF2E9" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <FontIcon Glyph="&#xE7C1;" FontSize="24" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Set a goal, build your future" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Create a savings goal to&#x0a;track your progress." FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Active Savings Goals -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Savings, Mode=OneWay}" Visibility="{x:Bind ViewModel.SavingsContentVisibility, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OverviewSavingsRow">
                                        <Border BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <StackPanel Spacing="6">
                                                <Grid>
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" />
                                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="{x:Bind ProgressDisplay}" />
                                                </Grid>
                                                <ProgressBar Value="{x:Bind ProgressPercentage}" Maximum="100" Height="6" CornerRadius="3" Foreground="{StaticResource SumaAccentBrush}" Background="{StaticResource SumaSurfaceSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Footer Action -->
                        <Button Grid.Row="2" Click="OnViewPlanningClick" HorizontalAlignment="Stretch" Height="40" CornerRadius="10" Background="Transparent" BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="1">
                            <TextBlock Text="Create goal" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 4: Lower Dashboard 2-Card Grid (Upcoming | Recent Activity) -->
            <Grid x:Name="LowerDashboardGrid" Grid.Row="4" ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LowerCol0" Width="*" />
                    <ColumnDefinition x:Name="LowerCol1" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LowerRow0" Height="Auto" />
                    <RowDefinition x:Name="LowerRow1" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Upcoming Card -->
                <Border x:Name="UpcomingCard" Grid.Column="0" Grid.Row="0" Style="{StaticResource SumaDashboardCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <TextBlock Grid.Row="0" Text="Upcoming" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" VerticalAlignment="Center" />

                        <!-- Body: Empty or Active State -->
                        <Grid Grid.Row="1">
                            <!-- Empty State (Matches visual reference mockup) -->
                            <Grid Visibility="{x:Bind ViewModel.UpcomingEmptyVisibility, Mode=OneWay}" ColumnSpacing="16" Margin="0,10" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Icon -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#FFEBF2E9" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="20" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="You're all caught up!" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                                    <TextBlock Text="No upcoming bills or&#x0a;scheduled expenses." FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Decorative Calendar Badge -->
                                <Border Grid.Column="2" Width="80" Height="70" CornerRadius="10" Background="#FFF3F6F1" BorderBrush="#FFE0E8DF" BorderThickness="1" Padding="8" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="#FF4A7C59" HorizontalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Clear" FontSize="11" FontWeight="SemiBold" Foreground="#FF5D725B" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Active Upcoming Items -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Upcoming, Mode=OneWay}" Visibility="{x:Bind ViewModel.UpcomingContentVisibility, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OverviewUpcomingDisplay">
                                        <Border BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind AmountDisplay}" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Recent Activity Card -->
                <Border x:Name="RecentActivityCard" Grid.Column="1" Grid.Row="0" Style="{StaticResource SumaDashboardCardStyle}">
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0">
                            <TextBlock Text="Recent Activity" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Click="OnViewActivityClick" HorizontalAlignment="Right" Content="View all" Style="{StaticResource SumaTextSubtleButtonStyle}" />
                        </Grid>

                        <!-- Body: Empty or Active State -->
                        <Grid Grid.Row="1">
                            <!-- Empty State -->
                            <StackPanel Visibility="{x:Bind ViewModel.ActivityEmptyVisibility, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20" Spacing="8">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#FFEBF2E9" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BF;" FontSize="20" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No recent activity" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Transactions will appear here as you record them." FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Active Activity List -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}" Visibility="{x:Bind ViewModel.ActivityContentVisibility, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:OverviewActivityDisplay">
                                        <Border BorderBrush="{StaticResource SumaBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon badge -->
                                                <Border Width="38" Height="38" CornerRadius="19" Background="#FFEBF2E9" VerticalAlignment="Center">
                                                    <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Title and Subtitle -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Bind SubtitleDisplay}" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                                                </StackPanel>

                                                <!-- Amount and Type -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                    <TextBlock Text="{x:Bind AmountDisplay}" Style="{StaticResource SumaBodyTextStyle}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{x:Bind TypeDisplay}" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- Footer Link: See more activity -->
                        <Button Grid.Row="2" Click="OnViewActivityClick" HorizontalAlignment="Stretch" Height="36" Background="Transparent" BorderThickness="0">
                            <Grid>
                                <TextBlock Text="See more activity" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" />
                                <FontIcon Glyph="&#xE76E;" FontSize="11" Foreground="{StaticResource SumaTextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Row 5: Footer Privacy Note -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,12,0,8">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Your financial data is private and secure." FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
