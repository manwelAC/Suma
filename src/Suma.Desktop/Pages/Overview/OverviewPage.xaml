<Page
    x:Class="Suma.Desktop.Pages.Overview.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:Suma.Desktop.ViewModels">
    <ScrollViewer>
        <StackPanel MaxWidth="920" Padding="32" Spacing="20">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource SumaPageTitleTextStyle}" Text="Overview" />
                    <TextBlock Style="{StaticResource SumaLeadTextStyle}" Text="A clear view of what is available today." />
                </StackPanel>
                <ComboBox x:Name="CurrencySelector" Grid.Column="1" MinWidth="110" Header="Currency" ItemsSource="{x:Bind ViewModel.Currencies, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCurrency, Mode=OneWay}" SelectionChanged="OnCurrencySelectionChanged" />
                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnRefreshClick" Content="Refresh" />
            </Grid>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />
            <InfoBar IsOpen="True" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Severity="Error" Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />
            <Border Style="{StaticResource SumaPlaceholderSurfaceStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="AVAILABLE TO SPEND" />
                    <TextBlock FontFamily="Segoe UI Variable Display" FontSize="40" FontWeight="SemiBold" Text="{x:Bind ViewModel.AvailableToSpendDisplay, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="Included account balances minus protected budget remaining." />
                    <Grid Margin="0,8,0,0" ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="INCLUDED BALANCE" /><TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.IncludedBalanceDisplay, Mode=OneWay}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="PROTECTED BUDGET" /><TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="{x:Bind ViewModel.ProtectedReserveDisplay, Mode=OneWay}" /></StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Accounts" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Accounts, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:OverviewAccountRow"><Grid Padding="0,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind Name}" /><TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind StatusDisplay}" /></StackPanel><TextBlock Grid.Column="1" Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind BalanceDisplay}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Current budget" />
            <Border Style="{StaticResource SumaPlaceholderSurfaceStyle}"><StackPanel Spacing="5"><TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind ViewModel.BudgetTitle, Mode=OneWay}" /><TextBlock Style="{StaticResource SumaBodySecondaryTextStyle}" Text="{x:Bind ViewModel.BudgetDetail, Mode=OneWay}" /></StackPanel></Border>
            <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Savings goals" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Savings, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:OverviewSavingsRow"><Grid Padding="0,7" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind Name}" /><TextBlock Grid.Column="1" Style="{StaticResource SumaBodySecondaryTextStyle}" Text="{x:Bind ProgressDisplay}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Upcoming" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Upcoming, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:OverviewUpcomingDisplay"><StackPanel Padding="0,7"><TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind Title}" /><TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind Detail}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Style="{StaticResource SumaSectionTitleTextStyle}" Text="Recent activity" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="viewModels:OverviewActivityDisplay"><StackPanel Padding="0,7"><TextBlock Style="{StaticResource SumaBodyTextStyle}" Text="{x:Bind Title}" /><TextBlock Style="{StaticResource SumaCaptionTextStyle}" Text="{x:Bind Detail}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
