<Page
    x:Class="Suma.Desktop.Pages.Lock.LockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SumaBackgroundBrush}">

    <Grid x:Name="RootLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top-Left Branding Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="48,36,48,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <Image Source="ms-appx:///Assets/Branding/SUMALOGO.png" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock Text="Suma" FontFamily="Segoe UI Variable Display" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                <TextBlock Text="Money, made clear." FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Middle Content: Mascot + Unlock Card -->
        <Grid Grid.Row="1" x:Name="ContentGrid" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="64" Margin="32,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MascotColDef" Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mascot Illustration -->
            <Image
                x:Name="MascotImage"
                Grid.Column="0"
                Source="ms-appx:///Assets/Mascot/protected.png"
                Width="380"
                Height="380"
                Stretch="Uniform"
                VerticalAlignment="Center"
                HorizontalAlignment="Right" />

            <!-- Unlock Card -->
            <Border
                Grid.Column="1"
                Width="440"
                Background="{StaticResource SumaSurfaceBrush}"
                BorderBrush="{StaticResource SumaBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                Padding="36,36,36,32"
                VerticalAlignment="Center">
                <Grid>
                    <!-- Normal PIN Entry Panel -->
                    <StackPanel x:Name="PinEntryPanel" Spacing="16">
                        <!-- Shield Icon Badge -->
                        <Border Width="48" Height="48" CornerRadius="24" Background="#FFEBF2E9" HorizontalAlignment="Center" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Title Block -->
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="Welcome back" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Unlock Suma" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Enter your local PIN to continue" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- PIN Boxes / Input Area -->
                        <Grid HorizontalAlignment="Center" Margin="0,10,0,0" Tapped="OnPinBoxesTapped">
                            <!-- 6 Visual PIN Boxes -->
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Border x:Name="Box0" Width="44" Height="50" CornerRadius="10" Background="#FFFAFAFA" BorderBrush="#FFE4E2DC" BorderThickness="1.5">
                                    <TextBlock x:Name="Dot0" Text="●" FontSize="16" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <Border x:Name="Box1" Width="44" Height="50" CornerRadius="10" Background="#FFFAFAFA" BorderBrush="#FFE4E2DC" BorderThickness="1.5">
                                    <TextBlock x:Name="Dot1" Text="●" FontSize="16" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <Border x:Name="Box2" Width="44" Height="50" CornerRadius="10" Background="#FFFAFAFA" BorderBrush="#FFE4E2DC" BorderThickness="1.5">
                                    <TextBlock x:Name="Dot2" Text="●" FontSize="16" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <Border x:Name="Box3" Width="44" Height="50" CornerRadius="10" Background="#FFFAFAFA" BorderBrush="#FFE4E2DC" BorderThickness="1.5">
                                    <TextBlock x:Name="Dot3" Text="●" FontSize="16" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <Border x:Name="Box4" Width="44" Height="50" CornerRadius="10" Background="#FFFAFAFA" BorderBrush="#FFE4E2DC" BorderThickness="1.5">
                                    <TextBlock x:Name="Dot4" Text="●" FontSize="16" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                                <Border x:Name="Box5" Width="44" Height="50" CornerRadius="10" Background="#FFFAFAFA" BorderBrush="#FFE4E2DC" BorderThickness="1.5">
                                    <TextBlock x:Name="Dot5" Text="●" FontSize="16" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                            </StackPanel>

                            <!-- Invisible PasswordBox that receives focus and input -->
                            <PasswordBox
                                x:Name="PinBox"
                                MaxLength="6"
                                PasswordChar="●"
                                Opacity="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                KeyDown="OnPinKeyDown"
                                PasswordChanged="OnPinPasswordChanged"
                                GotFocus="OnPinGotFocus"
                                LostFocus="OnPinLostFocus" />
                        </Grid>

                        <!-- Error / Busy Status -->
                        <StackPanel Spacing="6">
                            <ProgressRing IsActive="{Binding IsBusy}" Height="20" Width="20" Foreground="{StaticResource SumaAccentBrush}" HorizontalAlignment="Center" />
                            <InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}" CornerRadius="10" IsClosable="False" />
                        </StackPanel>

                        <!-- Unlock Button -->
                        <Button
                            x:Name="UnlockButton"
                            HorizontalAlignment="Stretch"
                            Height="44"
                            CornerRadius="10"
                            Background="#FF6F806D"
                            Foreground="#FFFFFFFF"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Content="Unlock"
                            Click="OnUnlock" />

                        <!-- "or" Separator -->
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Height="1" Fill="{StaticResource SumaBorderBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="or" FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" Margin="12,0" VerticalAlignment="Center" />
                            <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource SumaBorderBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Use Another PIN Action -->
                        <Button
                            HorizontalAlignment="Stretch"
                            Height="42"
                            CornerRadius="10"
                            Background="Transparent"
                            BorderBrush="{StaticResource SumaBorderBrush}"
                            BorderThickness="1"
                            Click="OnClearPinClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE75F;" FontSize="14" Foreground="{StaticResource SumaTextSecondaryBrush}" />
                                <TextBlock Text="Use another PIN" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Success State Panel -->
                    <StackPanel x:Name="SuccessPanel" Spacing="16" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                        <!-- Big Green Checkmark Badge -->
                        <Border Width="60" Height="60" CornerRadius="30" Background="#FFEBF2E9" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE73E;" FontSize="28" Foreground="#FF4F6A4C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Success Headings -->
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="PIN Verified!" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SumaTextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Welcome back! Unlocking Suma..." FontSize="14" Foreground="{StaticResource SumaTextSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Mascot Celebration -->
                        <Image Source="ms-appx:///Assets/Mascot/approved.png" Width="200" Height="200" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,4" />

                        <!-- Subtle Loading Indicator -->
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <ProgressRing IsActive="True" Width="16" Height="16" Foreground="{StaticResource SumaAccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Loading your finances..." FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Privacy Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,28">
            <FontIcon Glyph="&#xE72E;" FontSize="13" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Your financial data stays on this device." FontSize="12" Foreground="{StaticResource SumaTextSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
