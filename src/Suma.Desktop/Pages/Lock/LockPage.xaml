<Page x:Class="Suma.Desktop.Pages.Lock.LockPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="{StaticResource SumaBackgroundBrush}">
    <Grid Padding="32"><StackPanel Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><TextBlock HorizontalAlignment="Center" Style="{StaticResource SumaPageTitleTextStyle}" Text="Suma"/><TextBlock HorizontalAlignment="Center" Style="{StaticResource SumaLeadTextStyle}" Text="Enter your local PIN to unlock."/><PasswordBox x:Name="PinBox" Header="PIN" PlaceholderText="4–6 numeric digits" PasswordChar="●" KeyDown="OnPinKeyDown"/><Button HorizontalAlignment="Stretch" Content="Unlock" Click="OnUnlock"/><ProgressRing IsActive="{Binding IsBusy}"/><InfoBar IsOpen="{Binding HasError}" Severity="Error" Message="{Binding ErrorMessage}"/></StackPanel></Grid>
</Page>
