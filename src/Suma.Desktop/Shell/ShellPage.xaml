<Page
    x:Class="Suma.Desktop.Shell.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SumaShellBackgroundBrush}"
    RequestedTheme="Light"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{ThemeResource SumaShellSidebarBackgroundBrush}" Padding="16,24,16,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="8,0,8,32" Spacing="4">
                    <TextBlock
                        Foreground="{ThemeResource SumaShellTextPrimaryBrush}"
                        Style="{StaticResource SumaWordmarkTextStyle}"
                        Text="{x:Bind ViewModel.ApplicationTitle}" />
                    <TextBlock
                        Foreground="{ThemeResource SumaShellTextSecondaryBrush}"
                        Style="{StaticResource SumaCaptionTextStyle}"
                        Text="{x:Bind ViewModel.ApplicationTagline}" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <ToggleButton
                        x:Name="OverviewNavigationItem"
                        AutomationProperties.Name="Overview"
                        Click="OnNavigationClick"
                        Style="{StaticResource SumaNavigationItemStyle}"
                        Tag="Overview">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="{StaticResource SumaNavigationIconSize}" Glyph="&#xE80F;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Overview" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="AccountsNavigationItem"
                        AutomationProperties.Name="Accounts"
                        Click="OnNavigationClick"
                        Style="{StaticResource SumaNavigationItemStyle}"
                        Tag="Accounts">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="{StaticResource SumaNavigationIconSize}" Glyph="&#xE8C7;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Accounts" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="ActivityNavigationItem"
                        AutomationProperties.Name="Activity"
                        Click="OnNavigationClick"
                        Style="{StaticResource SumaNavigationItemStyle}"
                        Tag="Activity">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="{StaticResource SumaNavigationIconSize}" Glyph="&#xE9D2;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Activity" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="PlanningNavigationItem"
                        AutomationProperties.Name="Planning"
                        Click="OnNavigationClick"
                        Style="{StaticResource SumaNavigationItemStyle}"
                        Tag="Planning">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="{StaticResource SumaNavigationIconSize}" Glyph="&#xE8A5;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Planning" />
                        </Grid>
                    </ToggleButton>
                    <ToggleButton
                        x:Name="ReportsNavigationItem"
                        AutomationProperties.Name="Reports"
                        Click="OnNavigationClick"
                        Style="{StaticResource SumaNavigationItemStyle}"
                        Tag="Reports">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon FontSize="{StaticResource SumaNavigationIconSize}" Glyph="&#xE9D9;" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Reports" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>

                <ToggleButton
                    x:Name="SettingsNavigationItem"
                    Grid.Row="3"
                    AutomationProperties.Name="Settings"
                    Click="OnNavigationClick"
                    Style="{StaticResource SumaNavigationItemStyle}"
                    Tag="Settings">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon FontSize="{StaticResource SumaNavigationIconSize}" Glyph="&#xE713;" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Settings" />
                    </Grid>
                </ToggleButton>
            </Grid>
        </Border>

        <Frame x:Name="ContentFrame" Grid.Column="1" />
    </Grid>
</Page>
